# Grok Bot inbound webhook (required)
GROK_BOT_WEBHOOK_URL=https://example.invalid/webhooks/inbound
GROK_BOT_BEARER_TOKEN=crsr_replace_me

# Optional: override AppFolio JWKS (default is production)
# APPFOLIO_JWKS_URL=https://api.appfolio.com/.well-known/jwks.json

# Optional PostHog project token (phc_…). Unset → telemetry is a no-op (no network).
# Not a personal API key (phx_…). Set this in Vercel; do not commit a real value.
# POSTHOG_PROJECT_KEY=
# Optional ingest host. Default: https://us.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com
