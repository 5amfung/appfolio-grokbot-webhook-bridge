{
  "name": "appfolio-grokbot-webhook-bridge",
  "version": "0.6.0",
  "private": true,
  "description": "Thin HTTPS verify-and-forward for AppFolio webhooks → Grok Bot",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@vercel/functions": "3.10.5",
    "jose": "^6.0.11",
    "posthog-node": "5.61.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/core": "3.0.0",
    "@types/node": "^24.19.2",
    "@vercel/node": "^5.1.14",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.1.2"
  }
}
