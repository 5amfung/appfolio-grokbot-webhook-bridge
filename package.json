{
  "name": "appfolio-grokbot-webhook-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Thin HTTPS verify-and-forward for AppFolio webhooks → Grok Bot",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "jose": "^6.0.11",
    "posthog-node": "^5.61.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vercel/node": "^5.1.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
